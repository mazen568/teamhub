# TeamHub Docker Environment Variables (OPTIONAL)
# All defaults are built into docker-compose.yml.
# You only need to create this file if you want to enable optional features.
#
# To use: copy this file to `.env` in the root folder:
#   cp docker.env.example .env

# ─── OPTIONAL: AI Features ───────────────────────────────────────────
# Required ONLY if you want AI/LLM features to work
GROQ_API_KEY=your-groq-api-key-here

# ─── OPTIONAL: Image Uploads (Cloudinary) ────────────────────────────
# Required ONLY if you want image upload functionality
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── OPTIONAL: Override Defaults ─────────────────────────────────────
# Uncomment and change these only if you need custom values
# JWT_ACCESS_SECRET=your-custom-access-secret-minimum-32-characters
# JWT_REFRESH_SECRET=your-custom-refresh-secret-minimum-32-characters
# JWT_ACCESS_EXPIRES=15m
# JWT_REFRESH_EXPIRES=7d
# AI_SERVICE_TOKEN=your-custom-ai-service-token
